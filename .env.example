# ── Server ────────────────────────────────────────────────────────────────

# Port the Express server listens on. Optional — defaults to 8000 if unset.
PORT=

# Comma-separated list of allowed CORS origins (e.g. your admin dashboard URL(s)
# and any web frontends). If unset, only localhost dev origins are allowed.
# You choose these yourself based on where your admin panel/web clients are hosted.
CORS_ORIGINS=

# ── MongoDB ───────────────────────────────────────────────────────────────

# Full MongoDB connection string. Get this from MongoDB Atlas (Database > Connect
# > Drivers) or your own MongoDB server's connection URI.
MONGODB_URI=

# Database name to use within that MongoDB cluster/server. You choose this name.
MONGODB_DB_NAME=recoverai

# ── Auth ──────────────────────────────────────────────────────────────────

# Secret used to sign/verify user JWT tokens. Generate your own long random
# string, e.g. `openssl rand -hex 32`. Keep this secret and never commit it.
JWT_SECRET=

# OAuth Client ID for "Sign in with Google". Get this from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs) for your app's project.
GOOGLE_CLIENT_ID=

# ── Admin dashboard ───────────────────────────────────────────────────────

# Login email for the admin dashboard. You choose this yourself.
ADMIN_EMAIL=

# Login password for the admin dashboard. You choose this yourself — use a
# strong value, the code falls back to an insecure default if left unset.
ADMIN_PASSWORD=

# Secret used to sign admin JWT tokens (separate from JWT_SECRET). Generate
# your own long random string, e.g. `openssl rand -hex 32`.
ADMIN_JWT_SECRET=

# Shared secret for trusted server-to-server calls (e.g. another internal
# service writing to the knowledge base or admin endpoints without a login).
# You choose this yourself — a long random string.
INTERNAL_SERVICE_KEY=

# ── Email (Gmail SMTP, used for OTP verification / password reset emails) ──

# Gmail address the emails are sent from.
EMAIL_USER=

# Gmail App Password for that account (NOT your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled on the Gmail account).
EMAIL_PASS=

# ── OpenAI (AI Recovery Assistant) ───────────────────────────────────────

# NOTE: this backend does NOT read an OpenAI API key from env directly.
# services/openaiKey.service.js fetches the real key at runtime from the
# trusted shared key server (https://openaikeysecret.oxmite.com/api-key),
# caches it for 10 minutes, and refreshes it automatically — the key itself
# is never stored in this repo's .env. ADMIN_TOKEN below is the credential
# used to authenticate to that key server.

# Bearer token used to authenticate to the OpenAI key server above. Same
# trusted credential used across the other backends (e.g. devise_wise_backend) —
# obtain this value from whoever manages the shared key server, not from
# OpenAI directly.
ADMIN_TOKEN=

# Which OpenAI model to use for chat completions. Optional — defaults to
# gpt-4o-mini if unset. See https://platform.openai.com/docs/models.
OPENAI_MODEL=gpt-4o-mini

# ── AI Assistant chat usage limits ───────────────────────────────────────

# Max free AI Assistant chats for an unverified/guest-style user before they
# must upgrade. Optional — defaults to 3.
CARE_FREE_CHAT_LIMIT=3

# Max free AI Assistant chats for a fully registered free-tier user before
# they must upgrade to Premium. Optional — defaults to 5.
CARE_REGISTERED_CHAT_LIMIT=5

# ── Knowledge base write access ──────────────────────────────────────────

# API key required (as X-Knowledge-Key header or Bearer token) to create/edit/
# delete knowledge base articles without an admin login. You choose this
# yourself — a long random string.
KNOWLEDGE_API_KEY=

# ── Firebase (push notifications) — provide ONE of the three below ────────

# Full Firebase service-account JSON as a single-line string. Get this from
# Firebase Console > Project Settings > Service Accounts > Generate new
# private key, then minify the downloaded JSON to one line.
FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above: a filesystem path to the downloaded service-account
# JSON file (e.g. ./firebase-service-account.json in the repo root).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternative to the above: same JSON content as FIREBASE_SERVICE_ACCOUNT,
# kept as a separate name in case your host distinguishes the two.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Google Play (Android in-app purchase verification) ───────────────────

# Your app's Android package name (applicationId), e.g. com.yourcompany.recoverai.
# Find this in your Android project's build.gradle (applicationId) or the
# Google Play Console listing URL.
ANDROID_PACKAGE_NAME=

# Comma-separated list of your Premium subscription product/SKU IDs as
# configured in Google Play Console (Monetize > Products > Subscriptions),
# e.g. recoverai_premium_monthly,recoverai_premium_annual. A verified
# purchase is only granted premium if its productId is in this list — this
# stops any other product on your listing from accidentally unlocking
# premium. MUST be set before Android premium verification will work.
PREMIUM_PRODUCT_IDS_ANDROID=

# Full Google Play service-account JSON (single line) with API access to the
# Android Publisher API. Create it in Google Cloud Console (IAM & Admin >
# Service Accounts) for the project linked to your Play Console, grant it
# access under Play Console > Setup > API access, then minify the JSON here.
# Alternatively place the file at google-play-service-account.json in the
# repo root instead of setting this env var.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Set to "true" to hard-fail premium verification if Google Play verification
# fails (recommended for production). Left unset/false, verification falls
# back to trusting the client, which is only meant for development.
IAP_ANDROID_STRICT_VERIFY=false

# ── Amazon Appstore (Fire Tablet/Fire TV in-app purchase verification) ────

# Shared secret for Amazon's Receipt Verification Service (RVS). Get this
# from Amazon Developer Console > your app > Monetization Setup >
# In-App Purchasing, under your app's shared secret / Amazon RVS credentials.
AMAZON_RVS_SHARED_SECRET=

# Alternative name some Amazon docs/dashboards use for the same shared secret
# above — set whichever one Amazon's console labels it as for your app.
AMAZON_DEVELOPER_SECRET=

# Set to "true" to verify against Amazon's sandbox RVS endpoint instead of
# production, while testing purchases with Amazon's sandbox tooling.
AMAZON_RVS_SANDBOX=false

# Comma-separated list of your Premium subscription SKUs as configured in
# Amazon Developer Console (your app > Monetization > In-App Items), e.g.
# recoverai.premium.monthly,recoverai.premium.annual. Same purpose as
# PREMIUM_PRODUCT_IDS_ANDROID above — MUST be set before Amazon premium
# verification will work.
PREMIUM_PRODUCT_IDS_AMAZON=
